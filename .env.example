# ============================================================
# AI 短剧生成器 环境变量模板（仅占位符，不含任何真实密钥）
# 本地：复制为 .env 后填值（.env 已被 gitignore，禁止提交）
# Vercel：直接 Import .env 导入 .env（Settings → Environment Variables）
# 注意：Vercel 拒绝空值，未填的键保持注释状态，拿到值后去 # 填值再导入/补加
# 变量名以 src 代码实际读取为准（文档中心旧表中的 DATABASE_URL/OSS_* 已过期）
# ============================================================

# ---------- AI 顾问（NVIDIA） ----------
# NVIDIA_API_KEY 取值：本地 .env 中已有的 NVIDIA Key（勿提交到仓库）
# NVIDIA_API_KEY=<nvapi-...>
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ---------- 环境开关 ----------
# PROD：支付回调强制验签，禁用卡密重置/过期等开发接口；生产建议 PROD
COZE_PROJECT_ENV=PROD

# ---------- 服务端登录会话（新认证代码必填） ----------
# 至少 32 个字符的随机密钥。生成示例：openssl rand -base64 48
# 仅存放在服务端环境变量中，禁止使用 NEXT_PUBLIC_ 前缀或提交真实值。
# AUTH_SESSION_SECRET=<random-secret-at-least-32-characters>

# ---------- 数据库（Supabase）：登录/注册与全部用户数据持久化必填 ----------
# 缺失时登录接口 500；Vercel serverless 文件系统只读，
# 本地 .data 回退与 python3 取凭据回退均不可用。
# 取值：Supabase 控制台 → Project Settings → API
# COZE_SUPABASE_URL=https://<project-ref>.supabase.co
# COZE_SUPABASE_ANON_KEY=<anon public key>
# COZE_SUPABASE_SERVICE_ROLE_KEY=<service_role key，后端全权限>

# ---------- 站点域名与自调用 ----------
# 规范 URL / SEO / robots / sitemap / OAuth 回调域名，填 Vercel 部署域名
# COZE_PROJECT_DOMAIN_DEFAULT=https://<your-project>.vercel.app
# 视频队列自触发地址；NEXT_PUBLIC_ 构建期内联，首次构建前配置，改后需 Redeploy
# NEXT_PUBLIC_API_URL=https://<your-project>.vercel.app

# ---------- Coze 默认生成通道 + 对象存储 ----------
# 使用内置 Coze 通道生成（LLM/图像/视频/TTS）与素材上传存储时必填。
# 取值：Coze 编程工作区的「项目环境变量」。
# S3Storage 的 accessKey/secretKey 传空串，由 SDK 凭
# COZE_WORKLOAD_IDENTITY_API_KEY 换取临时凭据，故该 Key 同时决定存储可用性。
# COZE_WORKLOAD_IDENTITY_API_KEY=
# COZE_INTEGRATION_BASE_URL=
# COZE_INTEGRATION_MODEL_BASE_URL=
# COZE_BUCKET_ENDPOINT_URL=
# COZE_BUCKET_NAME=

# ---------- 可选：第三方模型通道 ----------
# 也可不填环境变量，改在站点「模型设置 → 自定义服务商」中配置
# ZHIPU_API_KEY=
# ZHIPU_BASE_URL=
# QWEN_API_KEY=
# QWEN_BASE_URL=

# ---------- 可选：支付宝支付 ----------
# ALIPAY_APPID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# 未配置支付时下单页展示的管理员联系方式
# ADMIN_CONTACT=

# ---------- 可选：Coze OAuth 登录 ----------
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# 'pkce'（移动端/SPA，默认）或 'code'（Web 后端）
# OAUTH_CLIENT_TYPE=pkce

# ---------- 兼容旧账号的密码盐 ----------
# 新注册账号使用带随机盐的 PBKDF2。此值仅用于旧账号首次登录时迁移，
# 应保持与旧部署一致；完成旧账号迁移后可移除。
# PASSWORD_SALT=

# ---------- 生产环境不要配置 ----------
# 开发者登录后门密码；不设置即禁用该接口
# DEV_LOGIN_PASSWORD=

# ---------- Vercel 上不需要 ----------
# DEPLOY_RUN_PORT：端口由 Vercel 运行时托管，仅本地 scripts 使用
# COZE_WORKSPACE_PATH：仅 Coze 平台 scripts 使用